<div class="bg-slate-800 shadow-lg rounded-lg p-8">
  <h2 class="text-2xl font-bold text-center text-slate-100 mb-6">ダッシュボード</h2>

  <!-- アカウント情報 -->
  <div class="mb-6">
    <h3 class="text-lg font-semibold text-slate-200 mb-3">アカウント情報</h3>
    <div class="bg-slate-900 rounded-md p-4 space-y-2">
      <div class="flex justify-between">
        <span class="text-sm text-slate-300">名前:</span>
        <span class="text-sm font-medium text-slate-100"><%= current_user.name %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-sm text-slate-300">メールアドレス:</span>
        <span class="text-sm font-medium text-slate-100"><%= current_user.email %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-sm text-slate-300">登録日:</span>
        <span class="text-sm font-medium text-slate-100"><%= current_user.created_at.strftime("%Y-%m-%d") %></span>
      </div>
    </div>
  </div>

  <!-- ログイン履歴 -->
  <div class="mb-6">
    <h3 class="text-lg font-semibold text-slate-200 mb-3">ログイン履歴</h3>
    <div class="bg-slate-900 rounded-md p-4 space-y-2">
      <div class="flex justify-between">
        <span class="text-sm text-slate-300">ログイン回数:</span>
        <span class="text-sm font-medium text-slate-100"><%= current_user.sign_in_count || 0 %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-sm text-slate-300">現在のログイン:</span>
        <span class="text-sm font-medium text-slate-100">
          <% if current_user.current_sign_in_at %>
            <%= current_user.current_sign_in_at.strftime("%Y-%m-%d %H:%M") %>
            <span class="text-xs text-slate-400">(<%= current_user.current_sign_in_ip %>)</span>
          <% else %>
            -
          <% end %>
        </span>
      </div>
      <div class="flex justify-between">
        <span class="text-sm text-slate-300">前回のログイン:</span>
        <span class="text-sm font-medium text-slate-100">
          <% if current_user.last_sign_in_at %>
            <%= current_user.last_sign_in_at.strftime("%Y-%m-%d %H:%M") %>
            <span class="text-xs text-slate-400">(<%= current_user.last_sign_in_ip %>)</span>
          <% else %>
            -
          <% end %>
        </span>
      </div>
    </div>
  </div>

  <!-- 連携アプリケーション -->
  <div class="mb-6">
    <h3 class="text-lg font-semibold text-slate-200 mb-3">連携アプリケーション</h3>
    <div class="bg-slate-900 rounded-md p-4">
      <% if @authorized_applications.present? %>
        <ul class="space-y-2">
          <% @authorized_applications.each do |app| %>
            <li class="flex justify-between items-center">
              <span class="text-sm font-medium text-slate-100"><%= app.name %></span>
              <span class="text-xs text-slate-400">連携中</span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-slate-400 text-center">連携しているアプリケーションはありません</p>
      <% end %>
    </div>
  </div>

  <!-- アクション -->
  <div class="space-y-3">
    <%= link_to "プロフィール編集", edit_user_registration_path, class: "block w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md transition duration-200 text-center" %>
    <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "w-full bg-slate-600 hover:bg-slate-500 text-white font-medium py-2 px-4 rounded-md transition duration-200 cursor-pointer" %>
  </div>
</div>
