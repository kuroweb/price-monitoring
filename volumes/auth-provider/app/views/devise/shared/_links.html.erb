<div class="mt-4 pt-4 border-t border-slate-700 text-center text-sm space-y-2">
  <%- if controller_name != 'sessions' %>
    <p>
      <%= link_to "ログイン", new_session_path(resource_name), class: "text-blue-300 hover:text-blue-200 hover:underline" %>
    </p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p>
      <%= link_to "新規登録", new_registration_path(resource_name), class: "text-blue-300 hover:text-blue-200 hover:underline" %>
    </p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p>
      <%= link_to "パスワードをお忘れですか？", new_password_path(resource_name), class: "text-blue-300 hover:text-blue-200 hover:underline" %>
    </p>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p>
      <%= link_to "確認メールが届かない場合", new_confirmation_path(resource_name), class: "text-blue-300 hover:text-blue-200 hover:underline" %>
    </p>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <p>
      <%= link_to "ロック解除メールが届かない場合", new_unlock_path(resource_name), class: "text-blue-300 hover:text-blue-200 hover:underline" %>
    </p>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <p>
        <%= button_to "Sign in with #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "w-full bg-slate-950 hover:bg-slate-700 text-slate-200 font-medium py-2 px-4 rounded-md transition duration-200" %>
      </p>
    <% end %>
  <% end %>
</div>
