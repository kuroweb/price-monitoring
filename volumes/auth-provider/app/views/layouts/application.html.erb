<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Auth Provider" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-950 min-h-screen flex flex-col">
    <!-- Navigation Header -->
    <header class="bg-slate-800 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 py-3">
        <div class="flex flex-wrap justify-between items-center gap-3">
          <%= link_to "Auth Provider", root_path, class: "text-xl font-bold text-slate-100 hover:text-slate-300" %>
          <nav class="flex flex-wrap items-center gap-4">
            <% if user_signed_in? %>
              <span class="text-sm text-slate-300">こんにちは、<%= current_user.name %>さん</span>
              <%= link_to "ダッシュボード", root_path, class: "text-sm text-blue-300 hover:text-blue-200 hover:underline" %>
              <%= link_to "プロフィール編集", edit_user_registration_path, class: "text-sm text-blue-300 hover:text-blue-200 hover:underline" %>
              <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "text-sm text-slate-300 hover:text-white hover:underline bg-transparent border-none cursor-pointer" %>
            <% else %>
              <%= link_to "ログイン", new_user_session_path, class: "text-sm text-blue-300 hover:text-blue-200 hover:underline" %>
              <%= link_to "新規登録", new_user_registration_path, class: "text-sm text-blue-300 hover:text-blue-200 hover:underline" %>
            <% end %>
          </nav>
        </div>
      </div>
    </header>

    <!-- Flash Messages -->
    <% if notice %>
      <div class="max-w-7xl mx-auto px-4 mt-4">
        <div class="bg-emerald-950 border border-emerald-800 rounded-md p-3 text-sm text-emerald-200">
          <%= notice %>
        </div>
      </div>
    <% end %>
    <% if alert %>
      <div class="max-w-7xl mx-auto px-4 mt-4">
        <div class="bg-red-950 border border-red-800 rounded-md p-3 text-sm text-red-200">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <!-- Main Content -->
    <main class="flex-1 flex items-center justify-center py-8">
      <div class="w-full max-w-md px-4">
        <%= yield %>
      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-slate-800 border-t border-slate-700 py-4">
      <div class="max-w-7xl mx-auto px-4 text-center text-sm text-slate-400">
        &copy; <%= Time.current.year %> Auth Provider. OpenID Connect Provider.
      </div>
    </footer>
  </body>
</html>
